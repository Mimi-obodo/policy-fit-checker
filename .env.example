# ==========================================================================
# Policy Fit Checker - Cloudflare Worker secrets template.
#
# The static site itself needs NO secrets and never reads this file.
# This is the template for the OPTIONAL live-LLM chat worker in worker/.
# These secrets are set on Cloudflare with `wrangler secret put`, NEVER in
# this repo and never in the frontend. Never commit a filled .env.
# ==========================================================================

# Required only if you deploy worker/worker.mjs.
# Google AI Studio key for the Gemini free tier. Set on Cloudflare:
#   cd worker && wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=

# Optional: override the default model (default is gemini-3.6-flash).
#   cd worker && wrangler secret put GEMINI_MODEL
GEMINI_MODEL=gemini-3.6-flash

# Client-side chat switch (never holds a key, just a public URL).
# Set in config.js on the site:
#   window.PFC_CONFIG.WORKER_URL = "https://pfc-agent-proxy.<your-subdomain>.workers.dev"
# Leave it empty ("") to run the deterministic live-pipeline chat instead.
