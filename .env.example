# ==========================================================================
# Policy Fit Checker - Option B (live LLM layer) - STRETCH ONLY
#
# The submitted baseline (Option A) is fully static and secret-free:
# the five agents are persona-grounded logic over live-fetched Google
# Sheets data, all in the browser. No keys are needed to run it.
#
# Option B would route agent steps through a real language model. Browsers
# cannot hold secrets, so a small serverless proxy is required. Fill these
# only if you deploy that proxy. Never commit a filled .env.
# ==========================================================================

# A serverless proxy URL that forwards to the model provider server-side.
# Example: https://your-proxy.example.com/v1/chat
PROXY_URL=

# Pick ONE provider and set its key on the proxy, NOT here.
# These variables are documented so the repo shows the design; they are
# never read by the static site.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: switch the pipeline to live-LLM mode when this is set to "1".
# When empty or "0", app.js stays in deterministic Option A mode.
LLM_MODE=0
